# Copy to .env (read automatically) or export as environment variables.

# Model -----------------------------------------------------------------
DETECT_BACKEND=ultralytics          # ultralytics | torchvision | package.module:Class
DETECT_MODEL_WEIGHTS=yolo11n.pt     # pretrained name or path to fine-tuned weights
# DETECT_MODEL_ARCH=                # ultralytics: yolo|rtdetr; torchvision: e.g. fasterrcnn_resnet50_fpn_v2
# DETECT_MODEL_LABELS=              # label file, required for fine-tuned torchvision checkpoints
# DETECT_MODEL_VERSION=             # tag echoed in every response
# DETECT_DEVICE=                    # cpu | cuda | cuda:0 | mps (auto when empty)

# Detection -------------------------------------------------------------
DETECT_TARGET_CLASSES=cat           # comma separated, "*" for all classes
DETECT_CONFIDENCE_THRESHOLD=0.25
DETECT_IOU_THRESHOLD=0.45
DETECT_IMAGE_SIZE=640
DETECT_MAX_DETECTIONS=100

# Limits ----------------------------------------------------------------
DETECT_MAX_UPLOAD_BYTES=10485760
DETECT_MAX_IMAGE_PIXELS=40000000
